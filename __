                stopInvis()  
                btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)  
                stroke.Color = Color3.fromRGB(180, 180, 180)  
                btn.Text = "👻"  
            end  
        end)  
    end  
})  
  
